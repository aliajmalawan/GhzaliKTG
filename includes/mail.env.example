# Copy this file to includes/mail.env and fill in values from cPanel > Email Accounts > Connect Devices.
# Do NOT commit mail.env. Do NOT guess these values.
MAIL_HOST=
MAIL_PORT=465
# ssl (port 465), tls (port 587 STARTTLS) or none
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=info@ghazaliktg.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@ghazaliktg.com
MAIL_FROM_NAME=Ghazali School & College Katlang
# Where website notifications (contact/admission) are delivered
MAIL_ADMIN_TO=info@ghazaliktg.com
